#define RT_MANIFEST 24
1 RT_MANIFEST "ferrous.manifest"
1 ICON "ferrous.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "KelboLive"
      VALUE "FileDescription", "Ferrous Studio"
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "Ferrous Studio"
      VALUE "OriginalFilename", "Ferrous Studio.exe"
      VALUE "ProductName", "Ferrous Studio"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "KelboLive"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
